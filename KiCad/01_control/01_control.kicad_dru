(version 1)

(rule HomeFab_edge_clearance
   (condition "A.Type != 'Pad'")
   (constraint edge_clearance (min 0.5mm))
   (severity error))

(rule HomeFab_via_geometry
   (condition "A.Type == 'Via'")
   (constraint via_diameter (min 1.5mm))
   (constraint annular_width (min 0.5mm))
   (severity error))

(rule HomeFab_hole_to_hole
   (condition "A.Type == 'Pad' || A.Type == 'Via'")
   (constraint hole_to_hole (min 0.5mm))
   (severity error))

(rule HomeFab_gnd_clearance
   (condition "A.NetName == 'GND'")
   (constraint clearance (min 0.2mm))
   (severity error))

(rule HomeFab_vin_width
   (condition "A.NetName == 'VIN_PROT'")
   (constraint track_width (min 0.4mm))
   (severity error))

(rule HomeFab_5v_width
   (condition "A.NetName == '+5V'")
   (constraint track_width (min 0.3mm))
   (severity error))
